# =============================================================================
# NOOR unified .env example
# - Docker Compose 读取这份 .env 做端口 / 挂载 / 构建参数插值
# - 后端也直接读取并回写这份 .env 作为应用配置
# =============================================================================

# --- Runtime / compose ---
HOST=0.0.0.0
PORT=9898
RELOAD=false
FRONTEND_PORT=19898
NOOR_DOCKER_PROFILE=full
INSTALL_NEMO=false
FULL_RUNTIME_IMAGE=nvidia/cuda:12.8.1-runtime-ubuntu24.04

# --- Host mounts / infrastructure ---
# Docker Compose 会把 NOOR_DATA_DIR 覆盖为容器内 /app/data；这里的值主要供本机直接运行后端时参考。
# MEDIA_ROOT 是宿主机媒体总根，必须改成当前机器真实存在的目录。
MODELS_DIR=/volume1/models
MEDIA_ROOT=/media
NOOR_DATA_DIR=/path/to/noor/data

# --- Media server ---
EMBY_SERVER=http://localhost:8096
EMBY_API_KEY=
EMBY_USER_ID=
EMBY_ENABLED_LIBRARY_IDS=
MEDIA_LIBRARY_PATH_PREFIX=/data/media
MEDIA_LIBRARY_LOCAL_PATH_PREFIX=/media
MEDIA_LIBRARY_SCAN_GROUPS=[]

# --- Storage ---
SOURCE_DIR=/media
OUTPUT_DIR=/media
# 默认留空也会自动使用 ${NOOR_DATA_DIR}/noor.db；需要外部数据库时再显式设置。
# DATABASE_URL=sqlite+aiosqlite:////path/to/noor/data/noor.db
WHISPER_MODEL_DIR=/volume1/models/huggingface
WHISPER_CACHE_DIR=/path/to/noor/data/runtime/whisper/cache
WHISPER_TEMP_DIR=/path/to/noor/data/runtime/whisper/temp
AUDIO_SEPARATOR_MODEL_DIR=/volume1/models/whisper/audio-separator
REAZON_MODEL_DIR=/volume1/models/whisper/reazon
REAZON_NEMO_MODEL_PATH=/volume1/models/whisper/reazon/reazonspeech-nemo-v2.nemo
LADA_MODEL_WEIGHTS_DIR=/volume1/models/lada_model_weights
LADA_CACHE_DIR=/path/to/noor/data/runtime/lada/cache
LADA_TEMP_DIR=/path/to/noor/data/runtime/lada/temp
FACEFUSION_MODEL_DIR=/volume1/models/facefusion
FACEFUSION_CACHE_DIR=/path/to/noor/data/runtime/facefusion/cache
FACEFUSION_TEMP_DIR=/path/to/noor/data/runtime/facefusion/temp
LADA_CLI_PATH=python3 -m lada.cli.main

# --- Whisper ---
WHISPER_STRATEGY=recommended
WHISPER_MODEL=anime-whisper
WHISPER_PIPELINE_MODE=ensemble
WHISPER_MERGE_STRATEGY=smart_merge
WHISPER_LANGUAGE=ja
WHISPER_SENSITIVITY=balanced
WHISPER_VAD_METHOD=semantic
WHISPER_AUDIO_PREPROCESS_MODE=none
WHISPER_AUDIO_PREPROCESS_MODEL=vocal_balanced
WHISPER_TRANSLATE_TO=
WHISPER_TRANSLATE_MODEL=gpt-4o-mini
WHISPER_TRANSLATE_STYLE=adult_explicit
WHISPER_TRANSLATE_BASE_URL=https://api.openai.com/v1
WHISPER_TRANSLATE_API_KEY=
WHISPER_PASS1_PIPELINE=anime
WHISPER_PASS2_PIPELINE=qwen
WHISPER_CUSTOM_CONFIG={"model":"large-v3","vad_method":"semantic","scene_detector":"semantic","enhancers":[],"segmenter":"silero-v6.2","timestamp_mode":"aligner_interpolation","aligner_backend":"qwen3","framer_backend":"vad-grouped"}

# --- LADA defaults ---
LADA_DEVICE=cuda:0
LADA_FP16=true
LADA_DETECTION_MODEL=v4-fast
LADA_RESTORATION_MODEL=basicvsrpp-v1.2
LADA_ENCODING_PRESET=hevc-nvidia-gpu-hq
LADA_MAX_CLIP_LENGTH=180
LADA_DETECT_FACE_MOSAICS=false

# --- Local subtitle library ---
LOCAL_LIBRARY_PATHS=[]
LOCAL_LIBRARY_INDEX_ENABLED=false
LOCAL_LIBRARY_MATCH_FUZZY=false

# --- Network / mirrors ---
ACCELERATION_MODE=mirror
HTTP_PROXY=
GITHUB_MIRROR=https://ghproxy.com
HF_MIRROR=https://hf-mirror.com
PIP_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple
HF_TOKEN=

# --- Dev ---
# NOOR_ENABLE_DEV_ENDPOINTS=false
