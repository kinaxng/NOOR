+        background = pool.get("background") if isinstance(pool.get("background"), dict) else {}
+
+    enabled = bool(config.get("full_scan_background_enabled", True))
+    interval = max(30, min(int(config.get("full_scan_interval_minutes") or 360), 10080))
+    running = bool(background.get("running"))
+    last_error = str(background.get("last_error") or "")
+    last_run_at = str(last.get("at") or background.get("started_at") or "")
+    next_run_at = _iso_plus_minutes(last.get("at"), interval) if enabled and last.get("at") else ""
+    scanned = last.get("scanned", background.get("last_scanned", 0))
+    added = last.get("added", background.get("last_added", 0))
+    updated = last.get("updated", 0)
+    detail_updated = last.get("detail_updated", background.get("last_detail_updated", 0))
+    warnings = last.get("warnings") if isinstance(last.get("warnings"), list) else []
+    task_status = "running" if running else ("failed" if last_error else ("idle" if enabled else "disabled"))
+    summary = _scan_summary(scanned, added, updated, detail_updated)
