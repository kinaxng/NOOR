+def _iso_plus_minutes(value: Any, minutes: int) -> str:
+    text = str(value or "").strip()
+    if not text:
+        return ""
+    try:
+        parsed = dt.datetime.fromisoformat(text.replace("Z", "+00:00"))
+        if parsed.tzinfo is None:
+            parsed = parsed.replace(tzinfo=dt.timezone.utc)
+        return (parsed.astimezone(dt.timezone.utc) + dt.timedelta(minutes=max(1, minutes))).isoformat()
+    except Exception:
+        return ""
+
