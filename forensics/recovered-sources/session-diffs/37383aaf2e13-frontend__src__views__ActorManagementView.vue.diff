+async function loadLatestMappingUpload() {
+  try {
+    const resp = await api.get('/media-library/actors/mapping/latest-upload')
+    mappingFile.value = resp.data.uploaded ? resp.data.file : null
+  } catch {
+    mappingFile.value = null
+  }
+}
+
+function openMappingPicker() {
+  fileInput.value?.click()
+}
+
+async function uploadMappingFile(event: Event) {
+  const input = event.target as HTMLInputElement
+  const file = input.files?.[0]
+  input.value = ''
+  if (!file) return
+  const form = new FormData()
+  form.append('file', file)
+  mappingUploading.value = true
+  try {
+    const resp = await api.post('/media-library/actors/mapping/upload', form, {
+      headers: { 'Content-Type': 'multipart/form-data' },
+    })
+    mappingFile.value = resp.data.file || null
+    toast.success(t('files.actors.mappingUploadSuccess'))
+  } catch (error: any) {
+    toast.error(error?.response?.data?.detail || error?.message || t('files.actors.mappingUploadFailed'))
+  } finally {
+    mappingUploading.value = false
+  }
+}
