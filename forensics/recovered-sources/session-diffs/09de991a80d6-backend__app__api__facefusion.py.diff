+def _source_image_payload(path: Path) -> dict[str, Any]:
+    stat = path.stat()
+    return {
+        "id": path.stem,
+        "name": path.name,
+        "path": str(path),
+        "preview_url": f"/api/facefusion/source-images/{path.stem}",
+        "size": stat.st_size,
+        "updated_at": stat.st_mtime,
+    }
+
