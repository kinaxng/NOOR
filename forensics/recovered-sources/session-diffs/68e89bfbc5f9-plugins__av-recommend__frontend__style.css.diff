 .av-rec-notice{min-height:0;font-size:12px;color:var(--color-text-muted,rgba(255,255,255,.52))}.av-rec-notice.is-loading,.av-rec-notice.is-warning,.av-rec-notice.is-error{padding:9px 11px;border-radius:12px;border:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.035)}.av-rec-notice.is-warning{border-color:rgba(245,158,11,.22);background:rgba(245,158,11,.08);color:#fcd59b}.av-rec-notice.is-error{border-color:rgba(239,68,68,.25);background:rgba(239,68,68,.1);color:#fecaca}
 .av-rec-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(430px,1fr));gap:12px}.av-rec-card{display:grid;grid-template-columns:168px minmax(0,1fr);min-height:210px;overflow:hidden;border:1px solid rgba(255,255,255,.065);background:var(--color-bg-surface,rgb(26,31,55));border-radius:16px}.av-rec-cover{border:0;padding:0;margin:0;background:rgba(255,255,255,.035);color:rgba(255,255,255,.4);overflow:hidden;cursor:pointer}.av-rec-cover img{width:100%;height:100%;object-fit:cover;display:block}.av-rec-body{min-width:0;padding:12px;display:flex;flex-direction:column;gap:8px}.av-rec-card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.av-rec-card-title{min-width:0;border:0;background:transparent;color:#fff;text-align:left;padding:0;display:grid;gap:3px;cursor:pointer}.av-rec-card-title strong{font-size:14px;font-weight:850}.av-rec-card-title span{font-size:12px;line-height:1.35;color:var(--color-text-secondary,rgba(255,255,255,.72));display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}.av-rec-score{width:48px;height:48px;flex:0 0 auto;border-radius:14px;display:grid;place-items:center;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.045)}.av-rec-score strong{font-size:18px;line-height:1}.av-rec-score span{font-size:9px;color:rgba(255,255,255,.5)}.av-rec-score--good{background:rgba(34,197,94,.14);border-color:rgba(34,197,94,.28)}.av-rec-score--hot{background:rgba(245,158,11,.16);border-color:rgba(245,158,11,.3)}
 .av-rec-meta,.av-rec-tags{display:flex;align-items:center;gap:5px;flex-wrap:wrap}.av-rec-badge{display:inline-flex;align-items:center;height:20px;padding:0 7px;border-radius:999px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.045);font-size:10px;font-weight:750;color:rgba(255,255,255,.76)}.av-rec-badge--good{border-color:rgba(34,197,94,.26);background:rgba(34,197,94,.12);color:#d9ffe7}.av-rec-badge--info{border-color:rgba(56,189,248,.25);background:rgba(56,189,248,.1);color:#d7f4ff}.av-rec-badge--hot{border-color:rgba(245,158,11,.28);background:rgba(245,158,11,.12);color:#ffe4b5}.av-rec-badge--warn{border-color:rgba(251,146,60,.28);background:rgba(251,146,60,.1);color:#fed7aa}.av-rec-badge--soft{background:rgba(255,255,255,.06)}.av-rec-badge--muted{color:rgba(255,255,255,.55);background:rgba(255,255,255,.035)}
-.av-rec-score-parts{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px;padding:6px;border:1px solid rgba(255,255,255,.055);border-radius:12px;background:rgba(255,255,255,.026)}.av-rec-score-parts span{display:flex;align-items:center;justify-content:space-between;gap:5px;min-width:0;padding:0 4px}.av-rec-score-parts em{font-size:10px;font-style:normal;color:rgba(255,255,255,.45)}.av-rec-score-parts strong{font-size:11px;color:rgba(255,255,255,.82)}
+.av-rec-score-parts{display:grid;grid-template-columns:repeat(auto-fit,minmax(48px,1fr));gap:6px;padding:6px;border:1px solid rgba(255,255,255,.055);border-radius:12px;background:rgba(255,255,255,.026)}.av-rec-score-parts span{display:flex;align-items:center;justify-content:space-between;gap:5px;min-width:0;padding:0 4px}.av-rec-score-parts em{font-size:10px;font-style:normal;color:rgba(255,255,255,.45)}.av-rec-score-parts strong{font-size:11px;color:rgba(255,255,255,.82)}
 .av-rec-reasons{margin:0;padding-left:16px;display:grid;gap:2px;color:var(--color-text-muted,rgba(255,255,255,.54));font-size:11px;line-height:1.4;min-height:32px}.av-rec-card-actions{margin-top:auto;display:flex;align-items:center;gap:6px;flex-wrap:wrap}.av-rec-card-actions button{height:28px;padding:0 10px;border-radius:9px;border:1px solid rgba(255,255,255,.08);background:rgba(255,255,255,.045);color:rgba(255,255,255,.75);font-size:11px;font-weight:760}.av-rec-card-actions button:hover{background:rgba(255,255,255,.075);color:#fff}.av-rec-card-actions button:disabled,.av-rec-card-actions button.is-disabled{cursor:not-allowed;opacity:.58}.av-rec-card-actions button:disabled:hover,.av-rec-card-actions button.is-disabled:hover{background:rgba(255,255,255,.045);color:rgba(255,255,255,.75)}.av-rec-card-actions .av-rec-primary{border-color:rgba(34,197,94,.25);background:rgba(34,197,94,.13);color:#eafff0}.av-rec-card-actions .av-rec-primary:disabled{border-color:rgba(255,255,255,.08);background:rgba(255,255,255,.04);color:rgba(255,255,255,.64)}.av-rec-empty{grid-column:1/-1;min-height:180px;border:1px dashed rgba(255,255,255,.1);border-radius:16px;display:grid;place-items:center;align-content:center;gap:6px;color:rgba(255,255,255,.55)}.av-rec-empty strong{color:#fff}.av-rec-skeleton{height:210px}.av-rec-skeleton>div,.av-rec-skeleton section b,.av-rec-skeleton section p{display:block;border-radius:12px;background:linear-gradient(90deg,rgba(255,255,255,.04),rgba(255,255,255,.08),rgba(255,255,255,.04));background-size:200% 100%;animation:av-rec-pulse 1.2s linear infinite}.av-rec-skeleton>div{margin:12px}.av-rec-skeleton section{padding:14px;display:grid;gap:10px;align-content:start}.av-rec-skeleton section b{height:22px}.av-rec-skeleton section p{height:14px}@keyframes av-rec-pulse{to{background-position:-200% 0}}
 @media(max-width:900px){.av-rec-topbar{display:grid}.av-rec-profile{grid-template-columns:repeat(2,1fr)}.av-rec-prefs{grid-column:1/-1}.av-rec-grid{grid-template-columns:1fr}.av-rec-card{grid-template-columns:132px 1fr}.av-rec-actions{justify-content:flex-start}}
 @media(max-width:560px){.av-rec-card{grid-template-columns:1fr}.av-rec-cover{aspect-ratio:1.42/1}.av-rec-profile{grid-template-columns:1fr 1fr}.av-rec-stat{min-height:62px}.av-rec-actions{display:grid;justify-content:stretch}.av-rec-modes{overflow:auto}}
