+def test_build_settings_payload_uses_resolved_storage_settings(monkeypatch: pytest.MonkeyPatch):
+    monkeypatch.setattr("app.api.settings_response.load_media_library_config", lambda: {})
+    monkeypatch.setattr(
+        "app.api.settings_response.get_settings",
+        lambda: SimpleNamespace(
+            source_dir="/media",
+            output_dir="/output",
+            noor_data_dir="/app/data",
+            database_url="sqlite+aiosqlite:////app/data/noor.db",
+            whisper_model_dir="/models/whisper",
+            whisper_cache_dir="/app/data/runtime/whisper/cache",
+            whisper_temp_dir="/app/data/runtime/whisper/temp",
+            audio_separator_model_dir="/app/data/models/whisper/audio-separator",
+            reazon_model_dir="/app/data/models/whisper/reazon",
+            reazon_nemo_model_path="/app/data/models/whisper/reazon/reazonspeech-nemo-v2.nemo",
+            lada_model_dir="/models/lada",
+            lada_cache_dir="/app/data/runtime/lada/cache",
+            lada_temp_dir="/app/data/runtime/lada/temp",
+            facefusion_model_dir="/app/data/models/facefusion",
+            facefusion_cache_dir="/app/data/runtime/facefusion/cache",
+            facefusion_temp_dir="/app/data/runtime/facefusion/temp",
+        ),
+    )
+
+    payload = build_settings_payload(
+        env_data={
+            "NOOR_DATA_DIR": "/host/noor/data",
+            "DATABASE_URL": "sqlite+aiosqlite:////host/noor/data/noor.db",
+            "WHISPER_CACHE_DIR": "/host/noor/data/runtime/whisper/cache",
+            "LADA_CACHE_DIR": "/host/noor/data/runtime/lada/cache",
+        },
+        version_info={
+            'version': '0.0.0',
+            'is_docker': False,
+            'is_submodule': False,
+            'install_mode': 'editable-repo',
+            'can_self_upgrade': False,
+            'upgrade_strategy': 'manual',
+            'upgrade_hint': '',
+            'repo_path': '',
+        },
+        lada_model_weights_dir="/host/models/lada",
+        whisper_features={},
+        custom_whisper_config={},
+    )
+
+    assert payload["storage"]["noor_data_dir"] == "/app/data"
+    assert payload["storage"]["database_path"] == "/app/data/noor.db"
+    assert payload["storage"]["whisper_cache_dir"] == "/app/data/runtime/whisper/cache"
+    assert payload["storage"]["lada_cache_dir"] == "/app/data/runtime/lada/cache"
+    assert payload["storage"]["lada_model_dir"] == "/models/lada"
+
