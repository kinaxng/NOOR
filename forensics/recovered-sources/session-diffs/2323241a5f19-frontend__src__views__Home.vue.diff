+async function pollMediaLibrarySyncState() {
+  try {
+    const resp = await api.get('/media-library/sync-state')
+    const version = Number(resp.data?.version || 0)
+    if (mediaSyncVersion === null) {
+      mediaSyncVersion = version
+      return
+    }
+    if (version !== mediaSyncVersion) {
+      mediaSyncVersion = version
+      mediaLibraryStore.invalidateCache()
+      await refreshCurrentPage(true)
+      toast.info('媒体库已同步 Emby 更新')
+    }
+  } catch {
+    // Keep polling lightweight; foreground requests still surface errors.
+  }
+}
+
+function startMediaLibrarySyncPolling() {
+  if (mediaSyncTimer) return
+  pollMediaLibrarySyncState()
+  mediaSyncTimer = setInterval(pollMediaLibrarySyncState, 20000)
+}
+
+function stopMediaLibrarySyncPolling() {
+  if (!mediaSyncTimer) return
+  clearInterval(mediaSyncTimer)
+  mediaSyncTimer = null
+}
