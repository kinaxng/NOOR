+def _load_actor_mappings() -> list[dict]:
+    path = _actor_mappings_path()
+    if not path.is_file():
+        return []
+    try:
+        import json
+
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except Exception:
+        return []
+    records = payload.get("records") if isinstance(payload, dict) else payload
+    if not isinstance(records, list):
+        return []
+    return [_normalize_actor_mapping(item) for item in records if isinstance(item, dict)]
