+def _split_actor_names(value: Any) -> list[str]:
+    if value is None:
+        return []
+    if isinstance(value, list):
+        parts = value
+    else:
+        parts = re.split(r"[,，;；/|、\n\r\t]+", str(value or ""))
+    out: list[str] = []
+    for part in parts:
+        name = str(part or "").strip()
+        if name and name not in out:
+            out.append(name)
+    return out
+
