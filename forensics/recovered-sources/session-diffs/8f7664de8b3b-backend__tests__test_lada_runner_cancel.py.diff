+from app.pipeline.lada.runner import LADA_PROGRESS_PHASE_ORDER, _build_lada_env, run_lada_restoration
+
+
+def test_lada_env_splits_runtime_cache_dirs(tmp_path: Path):
+    model_dir = tmp_path / "models" / "lada"
+    cache_dir = tmp_path / "runtime" / "lada" / "cache"
+    temp_dir = tmp_path / "runtime" / "lada" / "temp"
+
+    env = _build_lada_env(str(model_dir), str(cache_dir), str(temp_dir))
+
+    assert env["LADA_MODEL_WEIGHTS_DIR"] == str(model_dir)
+    assert env["XDG_CACHE_HOME"] == str(cache_dir / "xdg")
+    assert env["TORCH_HOME"] == str(cache_dir / "torch")
+    assert env["CUDA_CACHE_PATH"] == str(cache_dir / "cuda")
+    assert env["ORT_CACHE_DIR"] == str(cache_dir / "onnxruntime")
+    assert env["ORT_TENSORRT_CACHE_PATH"] == str(cache_dir / "onnxruntime" / "tensorrt")
+    assert env["TMPDIR"] == str(temp_dir)
+    assert (cache_dir / "xdg").is_dir()
+    assert (cache_dir / "torch").is_dir()
+    assert (cache_dir / "cuda").is_dir()
+    assert (cache_dir / "onnxruntime" / "tensorrt").is_dir()
 
 
 @pytest.mark.asyncio
