+def _version_tuple(value: str) -> tuple[int, int, int]:
+    match = re.search(r"(\d+)(?:\.(\d+))?(?:\.(\d+))?", value or "")
+    if not match:
+        return (0, 0, 0)
+    return tuple(int(part or 0) for part in match.groups())
+
+
+def _prefers_start_stop(version: str) -> bool:
+    return _version_tuple(version) >= (5, 2, 0)
+
+
+def _torrent_control_endpoints(action: str, version: str = "") -> list[str]:
+    new_pair = {
+        "pause": "/api/v2/torrents/stop",
+        "resume": "/api/v2/torrents/start",
+    }
+    old_pair = {
+        "pause": "/api/v2/torrents/pause",
+        "resume": "/api/v2/torrents/resume",
+    }
+    if action not in new_pair:
+        raise ValueError(f"unsupported torrent control action: {action}")
+    preferred = new_pair if _prefers_start_stop(version) else old_pair
+    fallback = old_pair if preferred is new_pair else new_pair
+    return [preferred[action], fallback[action]]
+
+
+async def _qb_version(client: httpx.AsyncClient, config: dict[str, Any]) -> str:
+    resp = await client.get(f"{_base(config)}/api/v2/app/version")
+    resp.raise_for_status()
+    return resp.text.strip()
+
