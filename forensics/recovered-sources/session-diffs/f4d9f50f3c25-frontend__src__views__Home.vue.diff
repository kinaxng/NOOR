+async function handleDeleteAction(item: MediaItem) {
+  if (!item?.id || deletingItemIds.value.has(item.id)) return
+  setDeletingItem(item.id, true)
+  try {
+    const preview = await api.post('/media-library/items/delete-chain', {
+      item_id: item.id,
+      dry_run: true,
+    })
+    const plannedDirs: string[] = preview.data?.planned_dirs || []
+    const plannedFiles: string[] = preview.data?.planned_files || []
+    const code = preview.data?.code || item.nfo?.num || item.name || item.id
+    const ok = await confirm({
+      title: `删除作品 ${code}`,
+      message: `将删除该作品的所有硬链接、源文件及同名 nfo。计划删除 ${plannedDirs.length} 个文件夹、${plannedFiles.length} 个文件。`,
+      confirmText: '删除',
+      cancelText: '取消',
+      danger: true,
+      size: 'xl',
+      note: '文件夹仅在其中的视频文件全部属于本次删除计划时才会删除；源文件位于根目录时只删除文件本身，不删除根目录。',
+      details: deletePlanDetails(plannedDirs, plannedFiles),
+    })
+    if (!ok) return
+
+    const resp = await api.post('/media-library/items/delete-chain', {
+      item_id: item.id,
+    })
+    mediaLibraryStore.applyHardlinkDeleteResult(resp.data || {})
+    toast.success('作品删除成功')
+    await confirm({
+      title: `删除结果 ${resp.data?.code || code}`,
+      message: `已删除 ${(resp.data?.deleted_dirs || []).length} 个文件夹、${((resp.data?.deleted_files || resp.data?.deleted_paths || []) as string[]).length} 个文件。`,
+      confirmText: '关闭',
+      hideCancel: true,
+      danger: false,
+      size: 'xl',
+      details: deleteResultDetails(resp.data || {}),
+    })
+    await refreshCurrentPage(true)
+  } catch (error: any) {
+    toast.error(error?.response?.data?.detail || error?.message || '作品删除失败')
+  } finally {
+    setDeletingItem(item.id, false)
+  }
+}
