+def test_inspect_whisper_model_cache_ignores_empty_repo_dirs(tmp_path: Path, monkeypatch):
+    custom_hf_root = tmp_path / "models" / "huggingface"
+    default_home = tmp_path / "home"
+    monkeypatch.setattr(Path, "home", lambda: default_home)
+
+    (custom_hf_root / "hub" / "models--litagin--anime-whisper").mkdir(parents=True)
+    (custom_hf_root / "hub" / "models--Systran--faster-whisper-large-v3").mkdir(parents=True)
+
+    models = inspect_whisper_model_cache(
+        whisper_model_dir=str(custom_hf_root),
+        whisper_models={"large-v3": {"size": "~3GB"}},
+    )
+
+    assert models["anime_whisper"]["downloaded"] is False
+    assert models["faster_large-v3"]["downloaded"] is False
