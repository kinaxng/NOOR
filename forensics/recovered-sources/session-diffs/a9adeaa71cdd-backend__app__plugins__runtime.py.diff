             with contextlib.suppress(Exception):
                 await self.stop_plugin_background(plugin_id)
 
+    async def get_background_tasks(self) -> list[dict[str, Any]]:
+        tasks: list[dict[str, Any]] = []
+        for pid, manifest in self._manifests.items():
+            if not self.is_enabled(pid):
+                continue
+            handler = get_plugin_handler(pid)
+            if not handler or not hasattr(handler, "background_tasks"):
+                continue
+            try:
+                data = await handler.background_tasks(self.get_config(pid))
+                items = data.get("items") if isinstance(data, dict) else data
+                if not isinstance(items, list):
+                    continue
+                for item in items:
+                    if not isinstance(item, dict):
+                        continue
+                    tasks.append({
+                        "plugin_id": pid,
+                        "plugin_name": manifest.name or pid,
+                        **item,
+                    })
+            except Exception as exc:
+                tasks.append({
+                    "id": f"{pid}.background_tasks",
+                    "plugin_id": pid,
+                    "plugin_name": manifest.name or pid,
+                    "title": manifest.name or pid,
+                    "status": "failed",
+                    "enabled": True,
+                    "summary": "后台任务状态读取失败",
+                    "detail": str(exc),
+                    "metrics": {},
+                })
+        return sorted(tasks, key=lambda item: (str(item.get("plugin_name") or ""), str(item.get("title") or "")))
+
     async def uninstall_plugin(self, plugin_id: str) -> None:
         async with self._lock:
             target = PLUGINS_DIR / plugin_id
