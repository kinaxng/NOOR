+def _merge_candidate(existing: dict[str, Any] | None, item: dict[str, Any], source: str, source_label: str) -> dict[str, Any]:
+    today = _today_key()
+    current = dict(existing or {})
+    if not current:
+        current.update(item)
+        current["first_seen_date"] = today
+        current["first_seen_at"] = dt.datetime.now(dt.timezone.utc).isoformat()
+    else:
+        for key, value in item.items():
+            if value not in (None, "", [], {}) and (not current.get(key) or key in {"magnets_count", "has_cnsub", "is_cracked"}):
+                if key == "magnets_count":
+                    current[key] = max(int(current.get(key) or 0), int(value or 0))
+                elif key in {"has_cnsub", "is_cracked"}:
+                    current[key] = bool(current.get(key) or value)
+                else:
+                    current[key] = value
+    sources = current.get("source_tags") if isinstance(current.get("source_tags"), list) else []
+    source_entry = {"id": source, "label": source_label, "date": today}
+    if not any(x.get("id") == source for x in sources if isinstance(x, dict)):
+        sources.append(source_entry)
+    current["source_tags"] = sources[:12]
+    current["last_seen_date"] = today
+    current["last_seen_at"] = dt.datetime.now(dt.timezone.utc).isoformat()
+    current["recommendation_source"] = source
+    current["recommendation_source_label"] = source_label
+    current["is_today_increment"] = str(current.get("first_seen_date") or "") == today
+    return current
+
