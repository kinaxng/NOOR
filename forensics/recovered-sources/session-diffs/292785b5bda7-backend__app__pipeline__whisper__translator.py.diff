+def _resolve_chat_completions_url(base_url: str) -> str:
+    """Resolve user configured OpenAI-compatible chat endpoint.
+
+    Users may enter either a service root, /v1, or a full chat endpoint. Keep a
+    full endpoint untouched so custom proxies can route /v1/chat themselves.
+    """
+    normalized = (base_url or "").rstrip("/")
+    lowered = normalized.lower()
+    if lowered.endswith("/v1/chat") or lowered.endswith("/v1/chat/completions"):
+        return normalized
+    if lowered.endswith("/v1"):
+        return f"{normalized}/chat/completions"
+    return f"{normalized}/v1/chat/completions"
+
+
+def _is_ollama_native_chat_url(base_url: str) -> bool:
+    return (base_url or "").rstrip("/").lower().endswith("/api/chat")
+
+
+def _resolve_ollama_root_url(base_url: str) -> str:
+    normalized = (base_url or "").rstrip("/")
+    lowered = normalized.lower()
+    if lowered.endswith("/api/chat"):
+        return normalized[:-len("/api/chat")]
+    if lowered.endswith("/api/generate"):
+        return normalized[:-len("/api/generate")]
+    return normalized
+
