+
+
+def test_local_subtitle_index_migrates_strongest_legacy_project_db(monkeypatch: pytest.MonkeyPatch, tmp_path):
+    weak_path = tmp_path / "subtitle_index.db"
+    strong_path = tmp_path / "backend" / "data" / "subtitle_index.db"
+    strong_path.parent.mkdir(parents=True)
+    for path, names in [
+        (weak_path, ["ABC-123"]),
+        (strong_path, ["XYZ-001", "XYZ-002"]),
+    ]:
+        conn = sqlite3.connect(path)
+        conn.execute("CREATE TABLE subtitle_index (base_name TEXT)")
+        for name in names:
+            conn.execute("INSERT INTO subtitle_index (base_name) VALUES (?)", (name,))
+        conn.commit()
+        conn.close()
+
+    monkeypatch.setattr(local_library, "data_path", lambda *parts: tmp_path.joinpath(*parts))
+    monkeypatch.setattr(local_library, "PROJECT_ROOT", tmp_path)
+
+    new_path = local_library._index_db_path()
+
+    conn = sqlite3.connect(new_path)
+    try:
+        rows = conn.execute("SELECT base_name FROM subtitle_index ORDER BY base_name").fetchall()
+    finally:
+        conn.close()
+    assert rows == [("XYZ-001",), ("XYZ-002",)]
