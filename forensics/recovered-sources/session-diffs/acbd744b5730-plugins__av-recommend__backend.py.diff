+def _ensure_candidate_pool() -> dict[str, Any]:
+    CANDIDATE_POOL_FILE.parent.mkdir(parents=True, exist_ok=True)
+    if not CANDIDATE_POOL_FILE.exists():
+        data = {"version": 1, "items": {}, "updated_at": "", "last_full_scan": {}}
+        CANDIDATE_POOL_FILE.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
+        return data
+    try:
+        data = json.loads(CANDIDATE_POOL_FILE.read_text(encoding="utf-8"))
+        if not isinstance(data, dict):
+            raise ValueError("invalid candidate pool")
+        data.setdefault("version", 1)
+        data.setdefault("items", {})
+        data.setdefault("updated_at", "")
+        data.setdefault("last_full_scan", {})
+        return data
+    except Exception:
+        backup = CANDIDATE_POOL_FILE.with_suffix(f".{int(time.time())}.bak")
+        try:
+            CANDIDATE_POOL_FILE.replace(backup)
+        except Exception:
+            pass
+        return _ensure_candidate_pool()
+
+
+def _save_candidate_pool(data: dict[str, Any]) -> None:
+    CANDIDATE_POOL_FILE.parent.mkdir(parents=True, exist_ok=True)
+    data["updated_at"] = dt.datetime.now(dt.timezone.utc).isoformat()
+    tmp = CANDIDATE_POOL_FILE.with_suffix(".tmp")
+    tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")
+    tmp.replace(CANDIDATE_POOL_FILE)
+
+
+def _candidate_pool_stats(pool: dict[str, Any]) -> dict[str, Any]:
+    today = _today_key()
+    items = pool.get("items") if isinstance(pool.get("items"), dict) else {}
+    today_count = 0
+    for item in items.values():
+        if not isinstance(item, dict):
+            continue
+        if str(item.get("first_seen_date") or "") == today:
+            today_count += 1
+    return {
+        "total": len(items),
+        "today_increment": today_count,
+        "updated_at": pool.get("updated_at") or "",
+        "last_full_scan": pool.get("last_full_scan") or {},
+    }
+
+
 def _text_has_subtitle(value: Any) -> bool:
     text = json.dumps(value, ensure_ascii=False) if isinstance(value, (dict, list)) else str(value or "")
