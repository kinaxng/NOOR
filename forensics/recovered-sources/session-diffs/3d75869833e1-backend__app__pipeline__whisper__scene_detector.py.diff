+class WhisperVadOnnxSceneDetector:
+    """Whisper-VAD ONNX based speech chunk detector.
+
+    The Hugging Face repo ships its own inference.py. NOOR loads that script
+    from the managed model cache instead of vendoring it into the application.
+    """
+
+    def __init__(
+        self,
+        repo_dir: str | Path,
+        threshold: float = 0.5,
+        min_speech_duration_ms: int = 300,
+        min_silence_duration_ms: int = 100,
+        speech_pad_ms: int = 200,
+        max_segment_duration: float = 30.0,
+        min_segment_duration: float = 3.0,
+        force_cpu: bool = False,
+    ):
+        self.repo_dir = Path(repo_dir)
+        self.threshold = threshold
+        self.min_speech_duration_ms = min_speech_duration_ms
+        self.min_silence_duration_ms = min_silence_duration_ms
+        self.speech_pad_ms = speech_pad_ms
+        self.max_segment_duration = max_segment_duration
+        self.min_segment_duration = min_segment_duration
+        self.force_cpu = force_cpu
+
+    def detect(self, audio_path: str) -> list[AudioSegment]:
+        inference_path = self._find_file("inference.py")
+        model_path = self._find_file("model.onnx")
+        metadata_path = self._find_file("model_metadata.json")
+        if not inference_path or not model_path:
+            raise RuntimeError("Whisper-VAD ONNX 模型未就绪，请先在 Whisper 模型管理中下载")
+
+        module = self._load_inference_module(inference_path)
+        audio, sr = librosa.load(audio_path, sr=16000, mono=True)
+        duration = len(audio) / 16000
+        model = module.WhisperVADOnnxWrapper(
+            str(model_path),
+            metadata_path=str(metadata_path) if metadata_path else None,
+            force_cpu=self.force_cpu,
+        )
+        speech_segments = module.get_speech_timestamps(
+            audio,
+            model,
+            threshold=self.threshold,
+            sampling_rate=16000,
+            min_speech_duration_ms=self.min_speech_duration_ms,
+            max_speech_duration_s=self.max_segment_duration,
+            min_silence_duration_ms=self.min_silence_duration_ms,
+            speech_pad_ms=self.speech_pad_ms,
+            return_seconds=True,
+        )
+
+        segments = [
+            AudioSegment(
+                start=max(0.0, float(seg["start"])),
+                end=min(duration, float(seg["end"])),
+                duration=max(0.0, min(duration, float(seg["end"])) - max(0.0, float(seg["start"]))),
+            )
+            for seg in speech_segments
+            if float(seg.get("end", 0)) > float(seg.get("start", 0))
+        ]
+        if not segments:
+            return [AudioSegment(start=0.0, end=duration, duration=duration)]
+
+        energy_detector = AudioSceneDetector(
+            mode="energy",
+            min_silence_duration=self.min_silence_duration_ms / 1000.0,
+            min_segment_duration=self.min_segment_duration,
+            max_segment_duration=self.max_segment_duration,
+        )
+        segments = energy_detector._merge_short_segments(segments)
+        segments = energy_detector._split_long_segments(audio, 16000, segments)
+        return segments
+
+    def _find_file(self, filename: str) -> Path | None:
+        for path in self.repo_dir.rglob(filename):
+            if path.is_file():
+                return path
+        return None
+
+    @staticmethod
+    def _load_inference_module(inference_path: Path):
+        spec = importlib.util.spec_from_file_location("noor_whisper_vad_onnx_inference", inference_path)
+        if spec is None or spec.loader is None:
+            raise RuntimeError(f"无法加载 Whisper-VAD ONNX inference.py: {inference_path}")
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        return module
