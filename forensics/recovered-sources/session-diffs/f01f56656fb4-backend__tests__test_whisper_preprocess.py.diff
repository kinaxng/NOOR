+    cache_dir = tmp_path / "runtime" / "whisper" / "cache"
+    temp_dir = tmp_path / "runtime" / "whisper" / "temp"
+    keys = ("AUDIO_SEPARATOR_MODEL_DIR", "HF_HOME", "HF_HUB_CACHE", "TORCH_HOME", "XDG_CACHE_HOME", "TMPDIR")
+    original_env = {key: os.environ.get(key) for key in keys}
+
+    try:
