+        assert os.environ["TORCH_HOME"] == str(cache_dir / "torch")
+        assert os.environ["XDG_CACHE_HOME"] == str(cache_dir)
+        assert os.environ["TMPDIR"] == str(temp_dir)
+    finally:
+        for key, value in original_env.items():
+            if value is None:
+                os.environ.pop(key, None)
+            else:
