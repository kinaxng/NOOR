+def test_facefusion_model_dir_symlinks_when_native_assets_are_absent(tmp_path):
+    facefusion_dir = tmp_path / "facefusion"
+    configured_model_dir = tmp_path / "models" / "facefusion"
+    facefusion_dir.mkdir()
+
+    model_dir, model_dir_mode = _resolve_model_dir(str(facefusion_dir), str(configured_model_dir))
+
+    native_model_dir = facefusion_dir / ".assets" / "models"
+    assert model_dir == str(configured_model_dir)
+    assert model_dir_mode == "configured_symlink"
+    assert native_model_dir.is_symlink()
+    assert native_model_dir.resolve() == configured_model_dir.resolve()
+
+
+def test_facefusion_model_dir_preserves_existing_native_assets(tmp_path):
+    facefusion_dir = tmp_path / "facefusion"
+    native_model_dir = facefusion_dir / ".assets" / "models"
+    configured_model_dir = tmp_path / "models" / "facefusion"
+    native_model_dir.mkdir(parents=True)
+    (native_model_dir / "existing.onnx").write_text("model")
+
+    model_dir, model_dir_mode = _resolve_model_dir(str(facefusion_dir), str(configured_model_dir))
+
+    assert model_dir == str(native_model_dir)
+    assert model_dir_mode == "native_assets_existing"
+    assert not native_model_dir.is_symlink()
+    assert (native_model_dir / "existing.onnx").exists()
