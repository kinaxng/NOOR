+
+        required_map = {
+            "lada": settings.gpu_guard_lada_required_free_mb,
+            "facefusion": settings.gpu_guard_facefusion_required_free_mb,
+            "whisper": settings.gpu_guard_whisper_required_free_mb,
+        }
