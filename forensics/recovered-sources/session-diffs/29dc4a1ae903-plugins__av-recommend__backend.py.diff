+def _subscription_codes() -> set[str]:
+    path = _subscription_store_file()
+    if not path.exists():
+        return set()
+    try:
+        data = json.loads(path.read_text(encoding="utf-8"))
+    except Exception:
+        return set()
+    out: set[str] = set()
+    for sub in data.get("subscriptions") or []:
+        if not isinstance(sub, dict) or sub.get("status") == "deleted":
+            continue
+        for key in ("code", "search_code", "title"):
+            code = _norm_code(sub.get(key))
+            if code:
+                out.add(code)
+    return out
