+def _safe_model_stem(filename: str) -> str:
+    stem = Path(filename or "model").stem.strip()
+    safe = "".join(ch if ch.isalnum() or ch in {"-", "_", "."} else "_" for ch in stem)
+    safe = safe.strip("._")
+    if not safe:
+        safe = f"model_{uuid4().hex[:8]}"
+    return safe[:96]
+
