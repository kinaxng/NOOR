{
  "id": "xunlei-remote",
  "name": "迅雷远程",
  "version": "0.1.0",
  "type": "downloader",
  "description": "通过群晖迅雷 NAS Web API 管理远程下载任务，并支持账号远程探针与移动端 fallback。",
  "tags": [
    "xunlei",
    "thunder",
    "downloader",
    "remote"
  ],
  "capabilities": [
    "downloader",
    "remote_tasks",
    "network_outbound",
    "download_submit",
    "sidebar_page"
  ],
  "enabled_by_default": false,
  "default_config": {
    "base_url": "",
    "entry_path": "/webman/3rdparty/pan-xunlei-com/index.cgi/",
    "authorization": "",
    "pan_auth": "",
    "insecure_skip_verify": true,
    "savepath": "",
    "restore_scan_roots": "",
    "restore_path_mappings": "",
    "timeout": 30,
    "cookie": "",
    "file_indices": "auto",
    "min_file_size_mb": 100,
    "account_access_token": "",
    "account_target": "",
    "account_parent_folder_id": "",
    "account_device_id": "",
    "mobile_access_token": "",
    "mobile_captcha_token": "",
    "mobile_shumei_boxid": "",
    "mobile_device_id": "",
    "mobile_peer_id": "",
    "mobile_target": "",
    "mobile_parent_folder_id": "",
    "mobile_client_id": "XoL5lqbDWNW0e7QA",
    "mobile_version_name": "2.6.10",
    "mobile_version_code": "21565",
    "mobile_package_name": "com.xunlei.mvideo",
    "mobile_device_model": "iPhone18"
  },
  "config_schema": {
    "base_url": {
      "type": "string",
      "label": "群晖地址",
      "description": "例如 https://nas:5001"
    },
    "entry_path": {
      "type": "string",
      "label": "迅雷入口路径"
    },
    "authorization": {
      "type": "password",
      "label": "DSM Authorization",
      "description": "从迅雷 NAS 请求头复制完整 Authorization: Basic ... 值。"
    },
    "cookie": {
      "type": "textarea",
      "label": "Cookie",
      "placeholder": "_SSID=...; SID=...; xtoken=...",
      "description": "群晖套件常见场景只需要 Cookie。可从迅雷 NAS 页面请求头复制完整 Cookie。"
    },
    "pan_auth": {
      "type": "password",
      "label": "pan_auth（可选）",
      "description": "留空时从迅雷页面自动提取。"
    },
    "insecure_skip_verify": {
      "type": "boolean",
      "label": "跳过证书校验",
      "description": "自签名群晖/迅雷地址默认开启。"
    },
    "savepath": {
      "type": "string",
      "label": "默认保存路径",
      "description": "必须能被迅雷 NAS 解析为实际目录；解析失败时不会回退到默认目录。"
    },
    "restore_scan_roots": {
      "type": "textarea",
      "label": "残留文件扫描目录",
      "description": "每行一个本地目录，用于扫描 .xltd/.xtld 未完成文件。"
    },
    "restore_path_mappings": {
      "type": "textarea",
      "label": "残留文件路径映射",
      "description": "每行 local=remote，用于把本地扫描路径映射为 NAS 远程路径。"
    },
    "timeout": {
      "type": "number",
      "label": "请求超时（秒）",
      "min": 5,
      "max": 120
    },
    "file_indices": {
      "type": "string",
      "label": "默认文件选择",
      "placeholder": "auto / --1 / 0 / 1,3 / 1-5",
      "description": "默认 auto：自动跳过明显广告小文件，保留字幕；--1 表示全部下载。"
    },
    "min_file_size_mb": {
      "type": "number",
      "label": "小文件过滤（MB）",
      "min": 0,
      "max": 4096
    },
    "account_access_token": {
      "type": "password",
      "label": "账号远程 Access Token",
      "placeholder": "不带 Bearer 前缀，来自 pan.xunlei.com 请求头",
      "description": "实验模式。用于验证迅雷账号远程链路是否可列出设备和创建任务；不影响 NAS 模式。"
    },
    "account_target": {
      "type": "string",
      "label": "账号远程设备 Target",
      "placeholder": "device_id#..."
    },
    "account_parent_folder_id": {
      "type": "string",
      "label": "账号远程目录 ID",
      "placeholder": "从账号远程路径探针返回中选择"
    },
    "account_device_id": {
      "type": "string",
      "label": "账号远程 Device ID",
      "placeholder": "可留空，NOOR 自动生成固定 device id"
    },
    "mobile_access_token": {
      "type": "password",
      "label": "移动端 Access Token",
      "placeholder": "Bearer ...",
      "description": "配额受限时自动 fallback 到移动端下载。"
    },
    "mobile_captcha_token": {
      "type": "textarea",
      "label": "移动端 Captcha Token"
    },
    "mobile_shumei_boxid": {
      "type": "textarea",
      "label": "移动端 Shumei Box ID"
    },
    "mobile_device_id": {
      "type": "string",
      "label": "移动端 Device ID / GUID"
    },
    "mobile_peer_id": {
      "type": "string",
      "label": "移动端 Peer ID"
    },
    "mobile_target": {
      "type": "string",
      "label": "移动端 Target",
      "placeholder": "device_id#..."
    },
    "mobile_parent_folder_id": {
      "type": "string",
      "label": "移动端目录 ID"
    },
    "mobile_client_id": {
      "type": "string",
      "label": "移动端 Client ID"
    },
    "mobile_version_name": {
      "type": "string",
      "label": "移动端版本名"
    },
    "mobile_version_code": {
      "type": "string",
      "label": "移动端版本号"
    },
    "mobile_package_name": {
      "type": "string",
      "label": "移动端包名"
    },
    "mobile_device_model": {
      "type": "string",
      "label": "移动端设备型号"
    }
  },
  "contributions": {
    "sidebar": {
      "label": "迅雷远程",
      "route": "/plugins/xunlei-remote",
      "icon": "icons/sidebar.svg"
    },
    "icon": "icons/sidebar.svg"
  },
  "frontend": {
    "type": "module",
    "entry": "frontend/page.js",
    "style": "frontend/style.css"
  }
}
