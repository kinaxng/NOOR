{
  "id": "av-recommend",
  "name": "推荐中心",
  "version": "1.0.0",
  "description": "基于媒体库偏好、JavDB 候选、完整候选池与资源可用性的推荐中心。",
  "type": "knowledge_app",
  "tags": ["official", "recommendation", "knowledge", "javdb"],
  "capabilities": ["sidebar_page", "knowledge_view", "recommendation_provider", "resource_search"],
  "enabled_by_default": true,
  "config_schema": {
    "candidate_limit": {"type": "number", "label": "候选扫描数量", "default": 48, "min": 12, "max": 120, "step": 12},
    "detail_limit": {"type": "number", "label": "详情分析数量", "description": "用于读取演员、类型和资源特征的候选数量。", "default": 36, "min": 8, "max": 80, "step": 4},
    "resource_enrich_limit": {"type": "number", "label": "资源确认数量", "description": "对排序靠前的作品确认各资源源站的可用资源。", "default": 16, "min": 0, "max": 48, "step": 4},
    "full_scan_pages": {"type": "number", "label": "完整推荐扫描页数", "description": "后台增量扫描 JavDB 完整作品列表的页数。", "default": 5, "min": 1, "max": 30, "step": 1},
    "full_scan_background_enabled": {"type": "boolean", "label": "启用完整推荐后台扫描", "default": true},
    "full_scan_interval_minutes": {"type": "number", "label": "完整推荐扫描间隔（分钟）", "default": 360, "min": 30, "max": 1440, "step": 30},
    "library_exclusion_scan_limit": {"type": "number", "label": "媒体库排除扫描上限", "description": "推荐生成时从 Emby 实时读取的番号上限，用于排除尚未进入 Knowledge Core 的已入库作品。", "default": 5000, "min": 500, "max": 20000, "step": 500},
    "prefer_cracked": {"type": "boolean", "label": "推荐时偏好破解", "default": true},
    "prefer_subtitle": {"type": "boolean", "label": "推荐时偏好中字", "default": true}
  },
  "default_config": {
    "candidate_limit": 48,
    "detail_limit": 36,
    "resource_enrich_limit": 16,
    "full_scan_pages": 5,
    "full_scan_background_enabled": true,
    "full_scan_interval_minutes": 360,
    "library_exclusion_scan_limit": 5000,
    "prefer_cracked": true,
    "prefer_subtitle": true
  },
  "contributions": {
    "sidebar": {"label": "推荐中心", "route": "/plugins/av-recommend", "icon": "icons/service.svg"},
    "icon": "icons/service.svg"
  },
  "frontend": {
    "type": "module",
    "entry": "frontend/page.js",
    "style": "frontend/style.css"
  }
}
